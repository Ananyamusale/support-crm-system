# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./tickets.db
TOKEN_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Set to true when served over HTTPS (adds Secure cookie flag + HSTS header)
COOKIE_SECURE=false
# Only needed if the front end is hosted on a different origin (comma separated)
ALLOWED_ORIGINS=
# API docs are disabled unless you set this to true (development only)
ENABLE_DOCS=false
